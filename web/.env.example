# Postgres connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rockitdocs"
# Where uploaded and generated files live (tenant-isolated subfolders). Swap for S3/R2 in production.
STORAGE_DIR="./storage"
# Root domain; tenants live at <subdomain>.ROOT_DOMAIN (e.g. interstaterock.theanswerai.com)
ROOT_DOMAIN="theanswerai.com"
# Tenant used when the host has no subdomain (local development)
DEV_TENANT="interstaterock"
# Enables AI document extraction (bid schedules, supplier PDF quotes)
ANTHROPIC_API_KEY=""
# Seed script: first admin for tenant #1
SEED_ADMIN_EMAIL="jack@theanswerai.com"
SEED_ADMIN_PASSWORD="change-me-now"
# Comma-separated emails allowed into the /platform tenant admin tool
PLATFORM_ADMIN_EMAILS="jack@theanswerai.com"
# Random 32+ character secret. Encrypts connected-mailbox tokens. Required for "Connect my email".
APP_SECRET=""
# Time zone for due dates and reminders (the bid's local time)
TZ="America/Denver"

# ---- Email (optional; without it, "sent" RFQs are saved in the log but not delivered) ----
# Resend API key (resend.com). Used for platform sending and company domains.
RESEND_API_KEY=""
# Platform sending domain, verified in Resend with SPF/DKIM/DMARC (e.g. mail.theanswerai.com)
MAIL_FROM_DOMAIN=""
MAIL_FROM_LOCAL="rfq"
# Public URL pattern for links in emails; {tenant} is replaced by the subdomain.
# Defaults to https://{tenant}.ROOT_DOMAIN in production.
APP_BASE_URL=""

# ---- Connect my email (optional) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# One host that receives OAuth callbacks for every tenant, e.g. https://interstaterock.theanswerai.com
# Register <this>/api/oauth/google/callback and <this>/api/oauth/microsoft/callback with the providers.
OAUTH_REDIRECT_BASE=""

# ---- Upload virus scanning (optional) ----
# clamd host[:port]. When set, uploads are refused if the scanner is unreachable or finds something.
CLAMAV_HOST=""
