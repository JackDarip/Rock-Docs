# Postgres connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rockitdocs"
# Where uploaded and generated files live (tenant-isolated subfolders). Swap for S3/R2 in production.
STORAGE_DIR="./storage"
# Root domain; tenants live at <subdomain>.ROOT_DOMAIN (e.g. interstaterock.theanswerai.com)
ROOT_DOMAIN="theanswerai.com"
# Tenant used when the host has no subdomain (local development)
DEV_TENANT="interstaterock"
# Enables AI document extraction (bid schedules, supplier PDF quotes)
ANTHROPIC_API_KEY=""
# Seed script: first admin for tenant #1
SEED_ADMIN_EMAIL="admin@interstaterock.com"
SEED_ADMIN_PASSWORD="change-me-now"
# Comma-separated emails allowed into the /platform tenant admin tool
PLATFORM_ADMIN_EMAILS=""
